@startuml
' Вертикальная диаграмма деятельности — Рис. 1.1
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10
top to bottom direction

start

:Загрузка данных подсистемы:\nрезультаты детекции с камеры,\nактивные бронирования, slot_overrides;

repeat
  :Сообщение об ошибке,\nповтор запроса к API;
repeat while (Данные загружены корректно?) is (нет)
->да;

:Отображение:\nполигоны свободных/занятых на кадре камеры,\nкарта мест, счётчики;

partition "Сценарий" {
}

if (Сценарий?) then (мониторинг с камеры)
  :Получение кадра с камеры;
  :Детекция YOLOv8-seg на сервере;
  :Классификация slot_free / slot_occupied;
  :Отрисовка полигонов на overlay;
  :Обновление счётчиков свободно/занято/всего;
elseif (карта мест) then
  :Показать карту мест и статусы;
  if (Действия пользователя?) then (просмотр)
    :Просмотр свободных и занятых;
  else (бронирование)
    :Выбор свободного места;
    :Проверка bookable(s);
  endif
elseif (статусы мест) then
  :Показать карту с ручными статусами;
  if (Изменение статуса?) then (нет)
    :Только просмотр;
  else (да)
    if (Роль: администратор?) then (да)
      :Установка статуса места;
      :Сохранение в БД;
    else (нет)
      :Только просмотр;
    endif
  endif
else (сводка)
  :Агрегация по состояниям слотов;
  :Расчёт индикатора загрузки;
  :Вывод сводки;
endif

:Обновление карты, overlay и сводки;

if (Продолжить работу?) then (да)
  detach
else (нет)
  stop
endif

@enduml
