@startuml
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10

|#White|Основной поток|
start
:Загрузка данных подсистемы:\nрезультаты детекции (slot_free / slot_occupied),\nактивные бронирования, slot_overrides;

repeat
  :Повтор запроса к API;
repeat while (Данные загружены корректно?) is (нет)
->да;

:Отображение:\nполигоны на кадре камеры (overlay),\nкарта мест, счётчики свободно/занято;

|#White|Сценарий|
if (Выбранный сценарий?) then (мониторинг с камеры)
  :Получение кадра с камеры;
  :Детекция YOLOv8-seg на сервере;
  :Классификация slot_free / slot_occupied;
  :Отрисовка полигонов на overlay;
  :Обновление счётчиков;
elseif (карта мест) then
  :Показать карту мест и статусы;
  if (Действия пользователя?) then (просмотр)
    :Просмотр свободных и занятых;
  else (бронирование)
    :Выбор свободного места;
    :Проверка bookable(s);
  endif
elseif (статусы мест) then
  :Показать карту с ручными статусами;
  if (Изменение статуса?) then (нет)
  else (да)
    if (Роль: администратор?) then (да)
      :Установка статуса места;
      :Сохранение в БД (slot_overrides);
    else (нет)
      :Отказ в изменении;
    endif
  endif
else (сводка)
  :Агрегация по состояниям слотов;
  :Расчёт индикатора загрузки (светофор);
  :Вывод сводки;
endif

:Обновление карты, overlay камеры и сводки;

if (Продолжить работу?) then (да)
  detach
else (нет)
  stop
endif

@enduml
